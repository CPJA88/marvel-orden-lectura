{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marvel-orden-lectura",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./src/worker-marvel-api-v17.js",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}
